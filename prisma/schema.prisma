generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  firstName   String
  lastName    String
  phone       String
  email       String?
  department  String
  city        String
  address     String
  reference   String
  complement  String?
  quantity    Int
  total       Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
